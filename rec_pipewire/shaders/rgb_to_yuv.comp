#version 460

// High-quality, high-throughput RGB -> NV12 / P010 compute shader.
// Compiled twice at build time: -DP010=0 (r8/rg8) and -DP010=1 (r16/rg16).
//
// Optimizations:
//  - Precomputed Y/Cb/Cr affine coefficients in push constants (3 dot() FMAs, zero branches)
//  - Guaranteed even dstExtent eliminates per-pixel store bounds checks
//  - 1:1 native: exact texelFetch luma + 3x2 AVCHROMA_LOC_LEFT anti-aliased chroma filter
//  - Scaled: 5-tap hardware-bilinear Catmull-Rom bicubic filter
//  - 8-bit NV12: single-hash static spatial triangular-PDF IGN dithering

#ifndef P010
#define P010 0
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uSrc;
#if P010
layout(set = 0, binding = 1, r16) uniform writeonly image2D uDstY;
layout(set = 0, binding = 2, rg16) uniform writeonly image2D uDstUV;
#else
layout(set = 0, binding = 1, r8) uniform writeonly image2D uDstY;
layout(set = 0, binding = 2, rg8) uniform writeonly image2D uDstUV;
#endif

layout(push_constant) uniform PushConstants {
    vec4 yCoeffs;       // xyz = scaled luma weights, w = luma offset
    vec4 cbCoeffs;      // xyz = scaled Cb weights,   w = chroma offset
    vec4 crCoeffs;      // xyz = scaled Cr weights,   w = chroma offset
    vec2 srcOffset;     // Crop origin in source pixels
    vec2 srcScale;      // (cropExtent / dstExtent) / srcSize
    vec2 srcBaseUv;     // (srcOffset + 0.5 * cropExtent / dstExtent) / srcSize
    vec2 invSrcSize;    // 1.0 / srcSize
    uvec2 dstExtent;    // Output video width, height (guaranteed even)
    uint flags;         // bit 0: exact1To1, bit 1: enableDither
    uint reserved;
} pc;

// 5-tap Catmull-Rom bicubic sampling using hardware bilinear texture units
vec3 sampleCatmullRom(vec2 uv) {
    vec2 texPos = uv / pc.invSrcSize - 0.5;
    vec2 f = fract(texPos);
    vec2 basePos = texPos - f;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12 = w1 + w2;
    vec2 off12 = w2 / max(w12, vec2(1e-5));

    vec2 tc0  = (basePos - 0.5) * pc.invSrcSize;
    vec2 tc12 = (basePos + 0.5 + off12) * pc.invSrcSize;
    vec2 tc3  = (basePos + 2.5) * pc.invSrcSize;

    vec3 c = vec3(0.0);
    c += textureLod(uSrc, vec2(tc12.x, tc0.y),  0.0).rgb * (w12.x * w0.y);
    c += textureLod(uSrc, vec2(tc0.x,  tc12.y), 0.0).rgb * (w0.x  * w12.y);
    c += textureLod(uSrc, vec2(tc12.x, tc12.y), 0.0).rgb * (w12.x * w12.y);
    c += textureLod(uSrc, vec2(tc3.x,  tc12.y), 0.0).rgb * (w3.x  * w12.y);
    c += textureLod(uSrc, vec2(tc12.x, tc3.y),  0.0).rgb * (w12.x * w3.y);

    float wSum = w12.x * (w0.y + w12.y + w3.y) + (w0.x + w3.x) * w12.y;
    return clamp(c / max(wSum, 1e-5), 0.0, 1.0);
}

#if !P010
// Single-hash static spatial Interleaved Gradient Noise -> triangular PDF in [-0.5, +0.5] LSB
float ignTriangular(vec2 p) {
    float n = fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
    float t = n * 2.0 - 1.0;
    float tri = sign(t) * (1.0 - sqrt(max(1.0 - abs(t), 0.0)));
    return tri * (0.5 / 255.0);
}
#endif

void main() {
    uvec2 uvCoord = gl_GlobalInvocationID.xy;
    uvec2 base = uvCoord * 2u;
    if (base.x >= pc.dstExtent.x || base.y >= pc.dstExtent.y) {
        return;
    }

    const bool exact1To1 = (pc.flags & 1u) != 0u;
    const bool enableDither = (pc.flags & 2u) != 0u;

    ivec2 c00 = ivec2(base);
    ivec2 c10 = ivec2(base.x + 1u, base.y);
    ivec2 c01 = ivec2(base.x, base.y + 1u);
    ivec2 c11 = ivec2(base.x + 1u, base.y + 1u);

    vec3 rgb00, rgb10, rgb01, rgb11;
    vec3 chromaRgb;

    if (exact1To1) {
        ivec2 off = ivec2(pc.srcOffset);
        int minX = off.x;

        rgb00 = texelFetch(uSrc, off + c00, 0).rgb;
        rgb10 = texelFetch(uSrc, off + c10, 0).rgb;
        rgb01 = texelFetch(uSrc, off + c01, 0).rgb;
        rgb11 = texelFetch(uSrc, off + c11, 0).rgb;

        // 3x2 anti-aliased cosited-left (AVCHROMA_LOC_LEFT) chroma kernel:
        // horizontal [0.25, 0.50, 0.25] centered on c00/c01, vertical [0.50, 0.50]
        int lx = max(off.x + c00.x - 1, minX);
        vec3 rgbL0 = texelFetch(uSrc, ivec2(lx, off.y + c00.y), 0).rgb;
        vec3 rgbL1 = texelFetch(uSrc, ivec2(lx, off.y + c01.y), 0).rgb;

        chromaRgb = 0.125 * (rgbL0 + rgbL1 + rgb10 + rgb11) + 0.25 * (rgb00 + rgb01);
    } else {
        rgb00 = sampleCatmullRom(pc.srcBaseUv + vec2(c00) * pc.srcScale);
        rgb10 = sampleCatmullRom(pc.srcBaseUv + vec2(c10) * pc.srcScale);
        rgb01 = sampleCatmullRom(pc.srcBaseUv + vec2(c01) * pc.srcScale);
        rgb11 = sampleCatmullRom(pc.srcBaseUv + vec2(c11) * pc.srcScale);
        chromaRgb = 0.25 * (rgb00 + rgb10 + rgb01 + rgb11);
    }

    vec4 ys = vec4(
        dot(pc.yCoeffs.xyz, rgb00),
        dot(pc.yCoeffs.xyz, rgb10),
        dot(pc.yCoeffs.xyz, rgb01),
        dot(pc.yCoeffs.xyz, rgb11)
    ) + pc.yCoeffs.w;

    float cb = dot(pc.cbCoeffs.xyz, chromaRgb) + pc.cbCoeffs.w;
    float cr = dot(pc.crCoeffs.xyz, chromaRgb) + pc.crCoeffs.w;

#if P010
    ys = round(clamp(ys, 0.0, 1.0) * 1023.0) * (64.0 / 65535.0);
    cb = round(clamp(cb, 0.0, 1.0) * 1023.0) * (64.0 / 65535.0);
    cr = round(clamp(cr, 0.0, 1.0) * 1023.0) * (64.0 / 65535.0);
#else
    if (enableDither) {
        ys.x += ignTriangular(vec2(c00));
        ys.y += ignTriangular(vec2(c10));
        ys.z += ignTriangular(vec2(c01));
        ys.w += ignTriangular(vec2(c11));
        float dc = ignTriangular(vec2(uvCoord));
        cb += dc;
        cr -= dc;
    }
    ys = clamp(ys, 0.0, 1.0);
    cb = clamp(cb, 0.0, 1.0);
    cr = clamp(cr, 0.0, 1.0);
#endif

    imageStore(uDstY, c00, vec4(ys.x, 0.0, 0.0, 1.0));
    imageStore(uDstY, c10, vec4(ys.y, 0.0, 0.0, 1.0));
    imageStore(uDstY, c01, vec4(ys.z, 0.0, 0.0, 1.0));
    imageStore(uDstY, c11, vec4(ys.w, 0.0, 0.0, 1.0));
    imageStore(uDstUV, ivec2(uvCoord), vec4(cb, cr, 0.0, 1.0));
}
